# Copy to backend/.env — placeholders only
DATABASE_URL=postgres://auction:auction@localhost:55432/auction
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=10
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Online Auction

# Optional
EMAIL_TRANSPORT=            # "local" keeps emails in memory (dev/tests); "local-fail" simulates a provider outage; empty = real provider (Brevo)
CORS_ORIGINS=               # comma-separated; defaults to FRONTEND_URL
TRUST_PROXY_HOPS=           # proxies in front of the API (Render: 1); empty = trust none
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_CHALLENGE_MAX_ATTEMPTS=5
# JWT_SECRET and SESSION_SECRET are REQUIRED: the API refuses to start without them.

# Worker (npm run worker)
WORKER_POLL_MS=5000
OUTBOX_BATCH=50
OUTBOX_LEASE_MS=30000        # a crashed dispatcher's events are re-claimed after this
OUTBOX_MAX_ATTEMPTS=10       # then the event is dead-lettered (dead_at set)
OUTBOX_RETRY_BASE_MS=1000    # exponential backoff: base * 2^(attempt-1), capped
OUTBOX_RETRY_MAX_MS=600000

# Public live updates (GET /auction/:id/events, SSE)
SSE_POLL_MS=1000             # each connection reads committed events of its auction this often
SSE_HEARTBEAT_MS=15000
SSE_REPLAY_LIMIT=50          # further behind than this -> "reset", the client refetches
SSE_MAX_PER_IP=20            # per API instance; behind a proxy set Express "trust proxy" or every user shares one IP
SSE_MAX_CONNECTIONS=1000

# Payments. "mock" = simulated gateway, NO real money; default outside production. Empty = manual proof only.
PAYMENT_ADAPTER=mock
MOCK_PAYMENT_SECRET=          # HMAC for mock webhooks; a dev default is used outside production
PAYMENT_RECONCILE_AFTER_MS=60000   # open attempts older than this are checked with the provider by the worker
PAYMENT_WINDOW_HOURS=48

# Observability
METRICS_TOKEN=                # if set, GET /metrics needs "Authorization: Bearer <token>"; unset = open in dev, 404 in production
WORKER_STALE_AFTER_MS=60000   # /health/ready reports the worker "stale" after this long without a pass
READY_DB_TIMEOUT_MS=2000      # readiness fails if the DB does not answer within this

# Media (uploads)
MEDIA_DIR=                    # private proofs; default backend/storage/private — must NOT be publicly served
PUBLIC_MEDIA_DIR=             # listing photos when Cloudinary is not configured; default backend/storage/public
PUBLIC_API_URL=               # absolute base for local listing-photo URLs; default derived from the request host
MEDIA_MAX_BYTES=5242880
MEDIA_PENDING_TTL_MS=3600000  # unattached uploads are removed by the worker after this
