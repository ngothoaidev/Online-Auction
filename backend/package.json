{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "start": "node server.ts",
    "start:render": "npm run db:migrate && (node worker.ts & node server.ts)",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "dev": "node --watch server.ts",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "db:backfill-maxima": "node scripts/backfill-maxima.ts",
    "worker": "node worker.ts",
    "db:audit-proofs": "node scripts/audit-legacy-proofs.ts",
    "db:resolve-reviews": "node scripts/resolve-reviews.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "postgres": "^3.4.4",
    "sanitize-html": "^2.18.0",
    "stripe": "^23.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "multer-storage-cloudinary": {
      "cloudinary": "$cloudinary"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
